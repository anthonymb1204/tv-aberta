<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vizzion.tvaberta" android:versionCode="17" android:versionName="1.7.2">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updates from inside the app: Android still asks the person to confirm each one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- CazéTV opens its official live in the YouTube app (TV or phone). One APK for TV and phone:
         each screen picks its orientation in code (TV landscape; phone list upright, player sideways). -->
    <queries><package android:name="com.google.android.youtube.tv" /><package android:name="com.google.android.youtube" /><package android:name="com.globo.globotv" /></queries>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="TV Aberta" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:allowBackup="false" android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustNothing|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".LastChannelProvider" android:authorities="com.vizzion.tvaberta.last"
            android:exported="true" />
        <activity android:name=".YouTubePlayerActivity" android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity android:name=".PlayerActivity" android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
    </application>
</manifest>
